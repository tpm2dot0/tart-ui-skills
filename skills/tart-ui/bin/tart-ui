#!/usr/bin/env bash
# tart-ui — see and drive a Tart macOS VM's GUI.
# The screen is reached through Tart's built-in VNC server
# (`tart run --vnc-experimental`), which serves the VM's real console
# framebuffer from Virtualization.framework: screenshots, pointer and keyboard
# all go over that one RFB channel while SIP stays enabled in the guest and
# nothing is written to the TCC databases. Commands run over plain SSH.
# Every subcommand is one-shot: no daemon, no persistent connection, no session
# state to keep in sync. See references/backends.md.
set -uo pipefail

VM="${TART_VM:-uitest}"
IMAGE="${TART_IMAGE:-ghcr.io/cirruslabs/macos-tahoe-vanilla:latest}"
GUEST_USER="${TART_USER:-admin}"
GUEST_PASS="${TART_PASS:-admin}"
CPU="${TART_CPU:-6}"
MEMORY="${TART_MEMORY:-8192}"
DISPLAY_SIZE="${TART_DISPLAY:-1440x900}"
CONF_DIR="${TART_UI_HOME:-$HOME/.config/tart-ui}"
KEY="$CONF_DIR/id_ed25519"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SELF_DIR/.." && pwd)"

log() { printf '[tart-ui] %s\n' "$*" >&2; }
die() { printf '[tart-ui] ERROR: %s\n' "$*" >&2; exit 1; }

ssh_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
          -o LogLevel=ERROR -o ConnectTimeout=10 -o ServerAliveInterval=15)

vm_ip()      { tart ip "$VM" 2>/dev/null; }
vm_exists()  { tart list 2>/dev/null | awk '{print $2}' | grep -qx "$VM"; }
vm_running() { tart list 2>/dev/null | awk -v v="$VM" '$2==v {print $NF}' | grep -q running; }

gssh() {
  local ip; ip="$(vm_ip)"
  [ -n "$ip" ] || die "VM '$VM' has no IP (not running? try: tart-ui up)"
  ssh -i "$KEY" "${ssh_opts[@]}" -o BatchMode=yes "$GUEST_USER@$ip" "$@"
}

# Password login, used exactly once per VM to plant the key.
gssh_pw() {
  command -v expect >/dev/null || die "'expect' is needed for first-time key install"
  # Values go through the environment: `expect -c` does not populate $argv,
  # and interpolating a password into the Tcl source would need escaping.
  TU_USER="$GUEST_USER" TU_IP="$(vm_ip)" TU_CMD="$1" TU_PASS="$GUEST_PASS" expect -c '
    set timeout 60
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
              -o LogLevel=ERROR -o PreferredAuthentications=password \
              -o NumberOfPasswordPrompts=1 -o ConnectTimeout=10 \
              -o PubkeyAuthentication=no $env(TU_USER)@$env(TU_IP) $env(TU_CMD)
    # The timeout branch is not optional: without it expect falls through to
    # `wait` and blocks forever on a child that is never going to finish.
    expect {
      "assword:" { send "$env(TU_PASS)\r"; exp_continue }
      timeout    { catch {exec kill -9 [exp_pid]}; exit 124 }
      eof        {}
    }
    catch wait result
    exit [lindex $result 3]
  '
}

install_key() {
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR"
  [ -f "$KEY" ] || { log "generating $KEY"; ssh-keygen -t ed25519 -N '' -C tart-ui -f "$KEY" -q; }
  gssh 'true' 2>/dev/null && return 0
  local pub; pub="$(cat "$KEY.pub")"
  # The trailing `sync` matters: a power cut before the filesystem flushes
  # would lose an unsynced authorized_keys.
  gssh_pw "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && \
           (grep -qF '$pub' ~/.ssh/authorized_keys || printf '%s\n' '$pub' >> ~/.ssh/authorized_keys) && \
           chmod 600 ~/.ssh/authorized_keys && sync" >/dev/null \
    || die "could not install ssh key (is the guest password '$GUEST_PASS'?)"
}

wait_ssh() {
  local deadline=$((SECONDS + ${1:-420})) ip
  while [ $SECONDS -lt $deadline ]; do
    ip="$(vm_ip)"
    [ -n "$ip" ] && nc -z -G 2 "$ip" 22 2>/dev/null && return 0
    sleep 3
  done
  return 1
}

# ------------------------------------------------------------------ lifecycle
cmd_create() {
  vm_exists && { log "VM '$VM' already exists"; return 0; }
  log "cloning $IMAGE -> $VM"
  tart clone "$IMAGE" "$VM" || die "clone failed"
  # A bare WxH is interpreted as points and macOS then picks a HiDPI mode, so
  # screenshots come back at 2x and every coordinate needs halving. Forcing
  # "px" keeps the framebuffer 1:1 with the numbers you feed to `click`.
  local disp="$DISPLAY_SIZE"; [[ "$disp" =~ (px|pt)$ ]] || disp="${disp}px"
  tart set "$VM" --cpu "$CPU" --memory "$MEMORY" --display "$disp" \
                 --no-display-refit --random-mac
}

cmd_boot() {
  vm_running && { log "'$VM' already running"; return 0; }
  mkdir -p "$CONF_DIR/logs"
  log "booting '$VM' on Tart's VNC display"
  local vmlog="$CONF_DIR/logs/$VM.log"
  : > "$vmlog"
  # --vnc-experimental attaches a real VZ display and serves it over VNC; that
  # attached display is also what lets auto-login own the console and bring
  # the desktop up (a display-less guest stays parked at loginwindow).
  # --no-graphics only suppresses opening a host viewer window for it.
  # Audio pass-through is off by default because it is noise for UI work, but
  # an audio app under test needs it: TART_AUDIO=1. Spelled out as two
  # branches because macOS ships bash 3.2, where `set -u` rejects an empty
  # array expansion.
  if [ "${TART_AUDIO:-0}" = "1" ]; then
    nohup tart run "$VM" --vnc-experimental --no-graphics </dev/null >>"$vmlog" 2>&1 &
  else
    nohup tart run "$VM" --vnc-experimental --no-graphics --no-audio </dev/null >>"$vmlog" 2>&1 &
  fi
  disown
  # macOS caps concurrent VZ guests (2 on most Macs). Report that immediately
  # rather than waiting out the full SSH timeout on a VM that never started.
  sleep 3
  if grep -qi "exceeds the system limit" "$vmlog"; then
    die "$(cat "$vmlog") — stop another VM first (tart list)"
  fi
  parse_vnc_endpoint "$vmlog" || die "'$VM' printed no VNC endpoint (see $vmlog): $(tail -3 "$vmlog")"
  wait_ssh 420 || die "'$VM' did not reach SSH in time (see $vmlog): $(tail -3 "$vmlog")"
  log "up at $(vm_ip), vnc on 127.0.0.1:$(awk '{print $2}' "$CONF_DIR/$VM.vnc")"
}

# The port and password are random on every `tart run`; the only place they
# exist is one line of boot output, either
#   Opening vnc://:PW@127.0.0.1:PORT...           (viewer window mode)
#   VNC server is running at vnc://:PW@127.0.0.1:PORT   (--no-graphics)
# Parse whichever appears and persist HOST PORT PASSWORD for every later call.
parse_vnc_endpoint() {
  local vmlog="$1" deadline=$((SECONDS + 60)) line
  while [ $SECONDS -lt $deadline ]; do
    line="$(grep -oE 'vnc://:[^@]+@[0-9.]+:[0-9]+' "$vmlog" | head -1)"
    if [ -n "$line" ]; then
      local pw="${line#vnc://:}"; pw="${pw%%@*}"
      local hp="${line##*@}"
      printf '%s %s %s\n' "${hp%%:*}" "${hp##*:}" "$pw" > "$CONF_DIR/$VM.vnc"
      chmod 600 "$CONF_DIR/$VM.vnc"
      return 0
    fi
    sleep 2
  done
  return 1
}

# One short-lived RFB connection per operation, against the endpoint persisted
# at boot.
rfb() {
  local ep="$CONF_DIR/$VM.vnc" host port pw
  [ -f "$ep" ] || die "no VNC endpoint for '$VM' (not booted by tart-ui? try: tart-ui boot)"
  read -r host port pw < "$ep"
  python3 "$SKILL_DIR/bin/rfb.py" --host "$host" --port "$port" --password "$pw" "$@"
}

cmd_provision() {
  local prov="$SKILL_DIR/provision/provision.sh"
  [ -f "$prov" ] || die "missing $prov"
  install_key
  scp -i "$KEY" "${ssh_opts[@]}" -q "$prov" "$GUEST_USER@$(vm_ip):/tmp/provision.sh" || die "copy provision failed"
  gssh "TART_PASS='$GUEST_PASS' bash /tmp/provision.sh" || die "provisioning failed"
}

# A pass is a real desktop, not a lit display: the console must belong to the
# logged-in user (auto-login makes stat report 501, loginwindow leaves it 0),
# the session agents that draw the desktop must be up (on a cold boot the
# wallpaper renders seconds before the menu bar and Dock do), and the
# framebuffer must hold an actual picture. A uniform frame compresses to
# almost nothing, so the size floor rejects black/asleep screens too.
cmd_verify() {
  local i probe="${TMPDIR:-/tmp}/tart-ui-verify.$$.png"
  for i in $(seq 1 40); do
    if gssh '[ "$(stat -f %u /dev/console)" = 501 ] && pgrep -x Dock >/dev/null \
             && pgrep -x Finder >/dev/null && pgrep -x ControlCenter >/dev/null' 2>/dev/null; then
      sleep 3   # give the freshly started agents a moment to actually draw
      if rfb shot "$probe" >/dev/null 2>&1 && [ -s "$probe" ] \
         && [ "$(wc -c < "$probe" | tr -d ' ')" -gt 40000 ]; then
        rm -f "$probe"; return 0
      fi
    fi
    rm -f "$probe"
    sleep 3
  done
  return 1
}

cmd_up() {
  cmd_create; cmd_boot; install_key
  if gssh 'test -f ~/.tart-ui-provisioned' 2>/dev/null; then
    log "already provisioned"
  else
    cmd_provision
    gssh 'touch ~/.tart-ui-provisioned; sync'
  fi
  cmd_verify || die "the guest did not reach a usable desktop.
        Check: tart-ui shot /tmp/probe.png   (a login screen? try: tart-ui login)
        and    tart-ui sh 'stat -f %u /dev/console'   (must be 501)"
  log "ready — TART_VM=$VM ip=$(vm_ip) display=$(cmd_size)"
}

cmd_down() {
  # Shut down from inside: `tart stop` is a hard power cut that loses writes.
  vm_running || { log "'$VM' is not running"; return 0; }
  log "shutting '$VM' down from inside"
  gssh 'sync; sudo shutdown -h now' >/dev/null 2>&1 || true
  local deadline=$((SECONDS + 150))
  while [ $SECONDS -lt $deadline ]; do
    vm_running || { log "stopped"; return 0; }
    sleep 2
  done
  log "guest ignored the shutdown; forcing"
  tart stop "$VM" -t 30
}

cmd_bake() {
  local target="${1:?usage: tart-ui bake <new-image-name>}"
  cmd_down
  tart list 2>/dev/null | awk '{print $2}' | grep -qx "$target" \
    && die "'$target' already exists — delete it first or pick another name"
  log "freezing '$VM' into '$target'"
  tart clone "$VM" "$target" || die "clone failed"
  log "done. Reuse it with:  TART_IMAGE=$target TART_VM=<new> tart-ui up"
}

# --------------------------------------------------------------------- screen
cmd_shot() { rfb shot "${1:--}"; }
cmd_size() { rfb size; }

# ---------------------------------------------------------------------- input
btn() { case "$1" in right) echo 3 ;; middle) echo 2 ;; *) echo 1 ;; esac; }
cmd_click()  { rfb click "$1" "$2" --button "$(btn "${3:-left}")" --count "${4:-1}"; }
cmd_dclick() { rfb click "$1" "$2" --count 2; }
cmd_rclick() { rfb click "$1" "$2" --button 3; }
cmd_move()   { rfb move "$1" "$2"; }
cmd_drag()   { rfb drag "$1" "$2" "$3" "$4"; }
cmd_scroll() {
  if [ $# -ge 3 ]; then rfb scroll "$1" "$2" "$3"; else rfb scroll "${1:--3}"; fi
}
cmd_type()   { rfb type "$*"; }
cmd_key()    { rfb key "$*"; }

# Type the account password at the loginwindow / lock screen and confirm the
# desktop actually came back. Auto-login plus the provisioning that disables
# the screen lock make this rare, but a guest paused long enough can still
# present a lock.
cmd_login() {
  rfb login --login-password "$GUEST_PASS"
  sleep 5
  cmd_verify || die "typed the password, but the desktop did not come back — check: tart-ui shot"
  log "desktop unlocked"
}

# ------------------------------------------------------------------ app focus
# lsappinfo talks to the launch-services daemon directly and needs no TCC
# grant, unlike System Events, which would need Accessibility.
cmd_frontmost() {
  gssh 'lsappinfo info -only name "$(lsappinfo front)"' \
    | sed -E 's/^"LSDisplayName"="(.*)"$/\1/'
}

# Launch and wait until the app owns the screen. Frontmost is the usable
# signal available without an Accessibility grant; the extra settle covers the
# gap between taking focus and the first window appearing.
cmd_open() {
  local app="${1:?usage: tart-ui open <AppName>}"
  gssh "open -a '$app' || exit 1
        for i in \$(seq 1 60); do
          f=\$(lsappinfo info -only name \"\$(lsappinfo front)\" 2>/dev/null)
          case \"\$f\" in *'\"$app\"'*) sleep 1; echo 'ready: $app'; exit 0 ;; esac
          sleep 0.5
        done
        echo \"WARN: '$app' did not become frontmost after 30s (\$f)\" >&2; exit 1"
}

# -------------------------------------------------------------------- viewing
# Open a live, interactive view of the VM's console in the host's Screen
# Sharing app, against the same Tart VNC endpoint the automation uses. Close
# the window to detach; the VM keeps running.
cmd_watch() {
  vm_running || die "VM '$VM' is not running"
  local ep="$CONF_DIR/$VM.vnc" host port pw
  [ -f "$ep" ] || die "no VNC endpoint for '$VM' (not booted by tart-ui?)"
  read -r host port pw < "$ep"
  log "opening a viewer on $host:$port (close the window to detach)"
  open "vnc://:$pw@$host:$port"
}

# ------------------------------------------------------------------- commands
cmd_sh()   { gssh "$@"; }
cmd_push() { scp -i "$KEY" "${ssh_opts[@]}" -q -r "$1" "$GUEST_USER@$(vm_ip):$2"; }
cmd_pull() { scp -i "$KEY" "${ssh_opts[@]}" -q -r "$GUEST_USER@$(vm_ip):$1" "$2"; }

cmd_xctest() {
  gssh 'xcode-select -p >/dev/null 2>&1' \
    || die "no Xcode in this guest. Install one inside the VM, or clone from an
        image that ships it (ghcr.io/cirruslabs/macos-tahoe-xcode:latest)."
  gssh "xcodebuild $*"
}

usage() {
  cat >&2 <<EOF
tart-ui — see and drive a Tart macOS VM's GUI (every call is one-shot)

  Lifecycle   up [VM] | down [VM] | bake <image> | provision [VM] | rm [VM] | ip [VM] | status
  Eyes        shot [FILE|-]            PNG of the guest screen, 1:1 with click coords
              size                     display size
  Hands       click X Y [left|right] [n] | dclick | rclick | move | drag X1 Y1 X2 Y2
              scroll DY [X Y] | type <text> | key <combo>      e.g. key cmd+space
  Focus       open <AppName>           launch and wait until it is frontmost
              frontmost                name of the frontmost app
  Watching    watch [VM]               open a live viewer on the VM's console
              login [VM]               type the password at a login/lock screen
  Commands    sh <cmd…> | push <l> <r> | pull <r> <l> | xctest <xcodebuild args…>

  A VM-scoped command takes the VM name inline, e.g.  tart-ui watch my-vm
  Otherwise TART_VM (or --vm) selects it.

  The screen goes through Tart's own VNC server (tart run --vnc-experimental):
  SIP stays enabled in the guest and no TCC database is touched.

  Env: TART_VM(=$VM) TART_IMAGE(=$IMAGE) TART_DISPLAY(=$DISPLAY_SIZE) TART_CPU TART_MEMORY
       TART_AUDIO=1 to pass host audio through to the guest
       RFB_KEY_PRESS/RFB_KEY_GAP to slow typing for a picky app
EOF
  exit 2
}

command -v tart >/dev/null || die "tart is not installed (brew install cirruslabs/cli/tart)"
[ $# -gt 0 ] || usage
if [ "$1" = "--vm" ]; then VM="$2"; shift 2; fi
[ $# -gt 0 ] || usage
sub="$1"; shift

# The VM-scoped subcommands take no other argument, so a bare name after them is
# the VM to act on. Consuming it here is what stops `tart-ui rm some-vm` from
# silently ignoring the name and operating on the default one instead.
case "$sub" in
  up|boot|create|provision|down|stop|rm|delete|ip|watch|size|frontmost|login|unlock)
    if [ $# -gt 0 ]; then VM="$1"; shift; fi
    [ $# -eq 0 ] || die "'$sub' takes at most a VM name, got: $*"
    ;;
esac

case "$sub" in
  up) cmd_up "$@" ;;            create) cmd_create "$@" ;;
  boot) cmd_boot "$@" ;;        provision) cmd_provision "$@" ;;
  down|stop) cmd_down "$@" ;;   bake) cmd_bake "$@" ;;
  rm|delete) cmd_down; tart delete "$VM"; rm -f "$CONF_DIR/$VM.vnc" ;;
  ip) vm_ip ;;                  status|list) tart list ;;
  shot|screenshot) cmd_shot "$@" ;;   size) cmd_size ;;
  click) cmd_click "$@" ;;      dclick|doubleclick) cmd_dclick "$@" ;;
  rclick|rightclick) cmd_rclick "$@" ;; move) cmd_move "$@" ;;
  drag) cmd_drag "$@" ;;        scroll) cmd_scroll "$@" ;;
  type) cmd_type "$@" ;;        key) cmd_key "$@" ;;
  open) cmd_open "$@" ;;        frontmost) cmd_frontmost ;;
  watch) cmd_watch ;;
  login|unlock) cmd_login ;;
  sh|exec) cmd_sh "$@" ;;       push) cmd_push "$@" ;;  pull) cmd_pull "$@" ;;
  xctest) cmd_xctest "$@" ;;
  *) usage ;;
esac
